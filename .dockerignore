# ---------------------------------------------------------------------------
# Docker build context exclusions.
#
# The Dockerfile_DO only copies `pom.xml` and `src/`, so nothing else is needed to
# build or run the application. Everything below is kept out of the context so
# the Droplet does not have to transfer it on every deploy.
#
# Do NOT add `src/`, `pom.xml` or anything under src/main/resources to this file:
# the Maven build needs the sources, and the application runtime needs
# src/main/resources (Flyway migrations in db/migration, PDF fonts in fonts/).
# ---------------------------------------------------------------------------

# Build output - regenerated inside the image
target/

# Version control metadata
.git/
.gitignore
.gitattributes

# CI configuration
.github/

# Nested frontend repository (separate project, ignored by the backend repo)
HRMS/

# Local secrets - the real .env lives only on the server at /opt/myhourly/backend/.env
.env
.env.*
*.env

# Local runtime scratch output
tmp/
output/
plans/
*.log

# IDE and editor state
.idea/
.vscode/
.freebuff/
*.iml
*.iws
*.ipr

# Documentation, PDFs and the legacy Jenkins pipeline are not needed to build
# or run the service.
docs/
*.md
*.pdf
Jenkinsfile

# Compose files belong to /opt/myhourly on the server, not to this image
docker-compose*.yml
docker-compose*.yaml

# Maven wrapper is not used: the build stage uses the maven base image.
# (Kept in the repository for developers building without Docker.)
.mvn/
mvnw
mvnw.cmd
