# =============================================================================
# MyHourly backend - environment file for the DIGITALOCEAN deployment
# -----------------------------------------------------------------------------
# Consumed by  docker-compose.do.yml   (env_file: .env.do)
# Spring profile: do  ->  src/main/resources/application-do.properties
#
#   cp .env.do.example .env.do        # then replace every CHANGE_ME
#   docker compose -f docker-compose.do.yml up -d --build backend
#
#   * .env.do is gitignored and must never be committed. This .example file is the
#     only tracked copy and it contains placeholders only.
#   * On the Droplet, create the real file with `umask 077` and `chmod 600` - it
#     holds database and object-storage credentials.
#   * Keep LF line endings. A CRLF file leaves a stray \r at the end of every
#     value, which silently corrupts passwords, URLs and signing keys.
#   * Syntax is KEY=value: no `export`, no quotes, no spaces around `=` and no
#     inline comments after a value.
#   * Never edit .env.do on the server if it is a committed file - it is not; it
#     is gitignored, so `git pull --ff-only` can never conflict with it.
# =============================================================================


# =============================================================================
# 1. DigitalOcean Managed PostgreSQL                                   [REQUIRED]
# =============================================================================
# Copy the JDBC URL from the cluster's "Connection Details" panel and keep the
# TLS parameters - Managed PostgreSQL refuses unencrypted connections.
# Add the Droplet to the cluster's "Trusted Sources" first, or the connection is
# refused. Example:
#   jdbc:postgresql://db-postgresql-blr1-12345-do-user-123-0.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL=jdbc:postgresql://CHANGE_ME.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_USER=doadmin
DATABASE_PASSWORD=CHANGE_ME


# =============================================================================
# 2. JWT signing key                                                   [REQUIRED]
# =============================================================================
# 64+ random characters. Rotating it invalidates every issued access and refresh
# token, so everyone is signed out.
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS


# =============================================================================
# 3. DigitalOcean Spaces (S3-compatible object storage)
# =============================================================================
# Spaces -> API -> Access Keys. These are Spaces keys: NOT a DigitalOcean API
# token and NOT an AWS IAM key.
#
# They are read into properties still named b2.* (b2.bucket, b2.access-key,
# b2.secret-key). That prefix is historical only - the client speaks plain S3 and
# Spaces is S3-compatible. There is no Backblaze dependency in this profile.
DO_SPACES_BUCKET=CHANGE_ME
DO_SPACES_KEY=CHANGE_ME
DO_SPACES_SECRET=CHANGE_ME

# The region the bucket actually lives in: blr1, nyc3, sgp1, fra1, ams3, sfo3,
# syd1. The SigV4 signature covers the region, so a wrong value fails uploads.
#                                                                    Default: blr1
DO_SPACES_REGION=blr1

# Optional. Leave it commented out - the endpoint is derived from
# DO_SPACES_REGION as https://<region>.digitaloceanspaces.com.
# Set it only for a CDN or a custom host.
#DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com

# Optional, and not read by any code. Kept for parity with a CDN URL.
#DO_SPACES_PUBLIC_URL=https://CHANGE_ME.cdn.digitaloceanspaces.com


# =============================================================================
# 4. Password-reset emails                                             [REQUIRED]
# =============================================================================
# Public HTTPS page of the frontend. A wrong value makes every emailed reset link
# unusable.
PASSWORD_RESET_FRONTEND_URL=https://CHANGE_ME/reset-password
# From address on reset emails. Must be a mailbox the SMTP relay is allowed to
# send as.
PASSWORD_RESET_EMAIL=noreply@CHANGE_ME


# =============================================================================
# 5. Mail relay                                                        [optional]
# =============================================================================
# The defaults below point at the shared development Gmail account. Override them
# for production.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD has no default on purpose: leaving it empty keeps the app
# booting, and mail then fails at send time, bounded by the 5s timeouts.
#SMTP_PASSWORD=CHANGE_ME
#SMTP_STARTTLS_ENABLE=true
# 465 instead of 587 needs STARTTLS=false and SSL=true.
#SMTP_SSL_ENABLE=false


# =============================================================================
# 6. Optional tuning
# =============================================================================
# Recipient of leave/attendance notifications.       Default: hr@company.com
#HR_EMAIL=hr@CHANGE_ME

# Token lifetimes in milliseconds. The access token is deliberately long-lived to
# match the frontend's refresh behaviour.
#   access   default 9000000    (2.5 h)
#   refresh  default 604800000  (7 d)
#ACCESS_TOKEN_EXPIRATION=9000000
#REFRESH_TOKEN_EXPIRATION=604800000

# Password-reset link lifetime in minutes.                     Default: 30
#PASSWORD_RESET_EXPIRATION=30


# =============================================================================
# 7. Set by docker-compose.do.yml - do NOT add them here
# =============================================================================
# `environment:` in the compose file wins over this file, so a copy here would
# only mislead:
#
#   SPRING_PROFILES_ACTIVE=do   pins the profile, so the container can never fall
#                               back to the `dev` default and connect to the
#                               shared development database
#   PORT=8080                   container-internal port
#
# Also note: the super-admin / manager / HR bootstrap accounts are NOT configurable
# in this profile. Their usernames and passwords are hardcoded in
# application.properties and seed/users.csv ships inside the JAR - change those
# before exposing this deployment.
# =============================================================================
