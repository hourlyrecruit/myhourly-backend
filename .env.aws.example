# =============================================================================
# MyHourly backend - environment file for the AWS deployment
# -----------------------------------------------------------------------------
# Consumed by  docker-compose.aws.yml   (env_file: .env.aws)
# Spring profile: aws  ->  src/main/resources/application-aws.properties
#
#   cp .env.aws.example .env.aws      # then replace every CHANGE_ME
#   docker compose -f docker-compose.aws.yml up -d --build backend
#
#   * .env.aws is gitignored and must never be committed. This .example file is
#     the only tracked copy and it contains placeholders only.
#   * On ECS / Elastic Beanstalk, put these keys in AWS Secrets Manager or SSM
#     Parameter Store and inject them as environment variables instead of
#     shipping a file. The names below are the ones the profile reads.
#   * Keep LF line endings. A CRLF file leaves a stray \r at the end of every
#     value, which silently corrupts passwords, URLs and signing keys.
#   * Syntax is KEY=value: no `export`, no quotes, no spaces around `=` and no
#     inline comments after a value.
# =============================================================================


# =============================================================================
# 1. Amazon RDS for PostgreSQL                                         [REQUIRED]
# =============================================================================
# Keep ?sslmode=require (or verify-full with the RDS CA bundle) so the connection
# is encrypted regardless of the instance's rds.force_ssl setting. Example:
#   jdbc:postgresql://myhourly.xxxx.ap-south-1.rds.amazonaws.com:5432/myhourly?sslmode=require
DATABASE_URL=jdbc:postgresql://CHANGE_ME.CHANGE_ME.ap-south-1.rds.amazonaws.com:5432/myhourly?sslmode=require
DATABASE_USER=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME


# =============================================================================
# 2. JWT signing key                                                   [REQUIRED]
# =============================================================================
# 64+ random characters. Rotating it invalidates every issued access and refresh
# token, so everyone is signed out.
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS


# =============================================================================
# 3. Region
# =============================================================================
# The single knob for the whole profile: unless overridden, it sets the S3 bucket
# region and the SES SMTP endpoint (email-smtp.<region>.amazonaws.com).
#
# ECS does not inject AWS_REGION the way Lambda does, so set it explicitly
# whenever the bucket and SES are not in ap-south-1.
#                                                                  Default: ap-south-1
AWS_REGION=ap-south-1


# =============================================================================
# 4. Amazon S3 - file storage
# =============================================================================
# Read into properties named aws.s3.* (this profile migrated off the legacy b2.*
# names). The bucket name is required:
AWS_S3_BUCKET=CHANGE_ME

# Credentials. S3StorageConfig builds the client from the SDK's DEFAULT
# credentials chain, which resolves in this order:
#   environment (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) -> instance profile
#   -> ECS task role -> SSO/shared config
# So on EC2/ECS with an attached role, leave both UNSET and let the role grant
# access - that is the preferred setup. Set them only for local runs or hosts
# without an instance role, and scope the IAM user to this one bucket.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Optional; defaults to AWS_REGION.
#AWS_S3_REGION=ap-south-1

# Optional; derived from the region as https://s3.<region>.amazonaws.com.
# Set it only for a VPC gateway endpoint or a custom host.
#AWS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Optional, and not read by any code. Kept for parity with a CDN URL.
#AWS_S3_PUBLIC_URL=https://CHANGE_ME.cloudfront.net


# =============================================================================
# 5. Amazon SES - SMTP interface                                       [optional]
# =============================================================================
# Create SMTP credentials in the SES console: they are generated per region and
# are NOT your IAM access keys. Port 587 with STARTTLS.
# The account needs production access, and every From address must be a verified
# identity in the same region as SMTP_HOST.
#
# Leaving SMTP_USERNAME / SMTP_PASSWORD empty keeps the app booting; mail then
# fails at send time, bounded by the 5s timeouts.
#SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
#SMTP_PORT=587
#SMTP_USERNAME=CHANGE_ME
#SMTP_PASSWORD=CHANGE_ME
#SMTP_STARTTLS_ENABLE=true
# 465 instead of 587 needs STARTTLS=false and SSL=true.
#SMTP_SSL_ENABLE=false
# Recipient of leave/attendance notifications.       Default: hr@company.com
#HR_EMAIL=hr@CHANGE_ME


# =============================================================================
# 6. Password-reset emails / seeded admin
# =============================================================================
# PASSWORD_RESET_FRONTEND_URL and PASSWORD_RESET_EMAIL have localhost and
# myhourly.com defaults in the profile - set them for a real deployment or the
# emailed links point nowhere.
#PASSWORD_RESET_FRONTEND_URL=https://CHANGE_ME/reset-password
#PASSWORD_RESET_EMAIL=noreply@CHANGE_ME
#PASSWORD_RESET_EXPIRATION=30

# Overrides app.super-admin.email. The password is NOT configurable here: it is
# hardcoded in application.properties and seed/users.csv ships inside the JAR.
# Change those before exposing this deployment.
#SUPER_ADMIN_EMAIL=superadmin@CHANGE_ME


# =============================================================================
# 7. Token lifetimes - optional
# =============================================================================
#   access   default 9000000    (2.5 h)
#   refresh  default 604800000  (7 d)
#ACCESS_TOKEN_EXPIRATION=9000000
#REFRESH_TOKEN_EXPIRATION=604800000


# =============================================================================
# 8. Set by docker-compose.aws.yml - do NOT add them here
# =============================================================================
# `environment:` in the compose file wins over this file, so a copy here would
# only mislead:
#
#   SPRING_PROFILES_ACTIVE=aws  pins the profile, so the container can never fall
#                               back to the `dev` default and connect to the
#                               shared development database
#   PORT=8080                   container-internal port
# =============================================================================
