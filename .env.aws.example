# =============================================================================
# MyHourly backend - environment file for the AWS deployment
# -----------------------------------------------------------------------------
# Consumed by  docker-compose.yml   (env_file: .env)
# Spring profile: aws  ->  src/main/resources/application-aws.properties

# =============================================================================
# 1. Amazon RDS for PostgreSQL                                         [REQUIRED]
# =============================================================================

DATABASE_URL=jdbc:postgresql://CHANGE_ME.CHANGE_ME.ap-south-1.rds.amazonaws.com:5432/myhourly?sslmode=require
DATABASE_USER=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME


# =============================================================================
# 2. JWT signing key                                                   [REQUIRED]
# =============================================================================

JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS


# =============================================================================
# 3. Region
# =============================================================================

# Default: ap-south-1

AWS_REGION=ap-south-1


# =============================================================================
# 4. Amazon S3 - file storage
# =============================================================================

AWS_REGION=ap-south-1
AWS_S3_BUCKET=CHANGE_ME

# =============================================================================
# 5. Amazon SES - SMTP interface                                       [optional]
# =============================================================================

#SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
#SMTP_PORT=587
#SMTP_USERNAME=CHANGE_ME
#SMTP_PASSWORD=CHANGE_ME
#SMTP_STARTTLS_ENABLE=true
# 465 instead of 587 needs STARTTLS=false and SSL=true.
#SMTP_SSL_ENABLE=false


# Recipient of leave/attendance notifications.       Default: hr@company.com
# HR_EMAIL=hr@CHANGE_ME

# =============================================================================
# 6. Password-reset emails / seeded admin
# =============================================================================

#PASSWORD_RESET_FRONTEND_URL=https://CHANGE_ME/reset-password
#PASSWORD_RESET_EMAIL=noreply@CHANGE_ME
#PASSWORD_RESET_EXPIRATION=30


#SUPER_ADMIN_EMAIL=superadmin@CHANGE_ME


# =============================================================================
# 7. Token lifetimes - optional
# =============================================================================

#ACCESS_TOKEN_EXPIRATION=9000000
#REFRESH_TOKEN_EXPIRATION=604800000


# =============================================================================
# 8. Set by docker-compose.aws.yml - do NOT add them here
# =============================================================================

#
#   SPRING_PROFILES_ACTIVE=aws  pins the profile, so the container can never fall
#                               back to the `dev` default and connect to the
#                               shared development database
#   PORT=8080                   container-internal port
# =============================================================================
